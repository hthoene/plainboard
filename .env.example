# PlainBoard starts without any configuration: everything else is set in the browser.
# Only if you want one of the things below: save this file as .env next to your docker-compose.yml
# and remove the "#" of that line. After a change: docker compose up -d

# --- Run it on a server ---------------------------------------------------------------------------
# By default PlainBoard is reachable from this machine only. To reach it from others, put a reverse
# proxy with TLS in front (docs/guide.md, "Behind a reverse proxy") and set a setup password: it is
# asked once, when the first account is created in the browser, so nobody else can claim a new server.
# PLAINBOARD_PASSWORD=choose-a-setup-password

# Only if the reverse proxy runs on another machine: listen on all addresses instead of 127.0.0.1.
# The port is then open without encryption: close it to everyone but the proxy in your firewall.
# PLAINBOARD_BIND=0.0.0.0

# Another port than 8080 on this machine (point the reverse proxy there).
# PLAINBOARD_PORT=9000

# --- Security (docs/guide.md, "Security") ------------------------------------------------------------
# Previews on a name of their own (pointed at this PlainBoard too). Without it they run sandboxed on
# PlainBoard's address, where a private preview loads nothing but its first page.
# PLAINBOARD_PREVIEW_ORIGIN=https://preview.example.com
# Behind a proxy that sends no X-Forwarded-Proto: mark the login cookie Secure anyway.
# PLAINBOARD_SECURE_COOKIES=true
# No Strict-Transport-Security header on HTTPS answers.
# PLAINBOARD_HSTS=false
# Further addresses whose pages may use the signed-in API (comma separated).
# PLAINBOARD_ALLOWED_ORIGINS=https://other.example.com

# --- PostgreSQL instead of SQLite ------------------------------------------------------------------
# By default PlainBoard keeps its data in one SQLite file in the data volume, which needs nothing.
# To use a PostgreSQL database of yours instead (docs/guide.md, "PostgreSQL"):
# PLAINBOARD_DATABASE=postgresql://plainboard:change-me@db:5432/plainboard

# --- Let agents work in a folder of your machine -----------------------------------------------------
# By default agents work in a Docker volume. Name a folder here (e.g. D:/Code or /home/me/code), then
# name a sub folder of it in a project: Project settings -> Advanced -> Shared folder.
# PLAINBOARD_WORKSPACES_DIR=/home/me/code

# --- Rarely needed, and only when PlainBoard is built from a clone of the repository -----------------------
# Leave out the browser window (Chromium, about 700 MB of the runner image). Rebuild after changing:
# docker compose up -d --build
# PLAINBOARD_BROWSER=0

# A fork: where the "newer version" notice looks for newer commits.
# PLAINBOARD_UPDATE_REPOSITORY=hthoene/plainboard

# Credentials are entered in the browser (PlainBoard settings). These are only fallbacks for an
# account or a GitHub access that has none of its own there.
# PLAINBOARD_ANTHROPIC_API_KEY=
# PLAINBOARD_CLAUDE_CODE_OAUTH_TOKEN=
# PLAINBOARD_OPENAI_API_KEY=
# PLAINBOARD_GITHUB_TOKEN=
