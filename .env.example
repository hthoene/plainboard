# Copy to .env and adjust. Everything here is optional.

# Port and bind address of the web UI. Keep 127.0.0.1 on desktops; on a server use 0.0.0.0
# together with a password (and ideally a reverse proxy with TLS).
PLAINBOARD_PORT=8080
PLAINBOARD_BIND=127.0.0.1
PLAINBOARD_PASSWORD=

# Folder the agents work in. Default: a Docker volume. Desktop users can point this to a host
# folder (e.g. D:/Code or /home/me/code) and set a project's "Local folder" to a sub folder.
# PLAINBOARD_WORKSPACES_DIR=D:/Code

# Credentials are normally entered in the UI (Settings). These are optional fallbacks:
# Anthropic API key (recommended)
PLAINBOARD_ANTHROPIC_API_KEY=
# or your own Claude login token, created with `claude setup-token` (see README notes)
PLAINBOARD_CLAUDE_CODE_OAUTH_TOKEN=
# Fine-grained GitHub personal access token (optional)
PLAINBOARD_GITHUB_TOKEN=
